# Copiar a .env y completar. Ninguna clave va al repositorio.
ALEPH_ENV=dev
ALEPH_DATABASE_URL=sqlite:///./aleph.db
ALEPH_SECRET_KEY=
ALEPH_DATA_DIR=./data

# FUNES: endpoints compatibles con OpenAI dentro de la red propia
ALEPH_LLM_BASE_URL=http://127.0.0.1:4000/v1
ALEPH_LLM_API_KEY=
ALEPH_LLM_MODEL=
ALEPH_EMBED_BASE_URL=http://127.0.0.1:8081/v1
ALEPH_EMBED_API_KEY=
ALEPH_EMBED_MODEL=bge-m3
# Con Ollama (por ejemplo, el contenedor aleph-ollama del nodo 1), las dos cosas salen del mismo servidor:
#   ALEPH_LLM_BASE_URL=http://100.64.0.10:11435/v1
#   ALEPH_LLM_MODEL=qwen3:8b
#   ALEPH_LLM_REASONING_EFFORT=none   (sin esto qwen3 "piensa" antes de responder: más lento)
#   ALEPH_EMBED_BASE_URL=http://100.64.0.10:11435/v1
#   ALEPH_EMBED_MODEL=bge-m3
ALEPH_LLM_REASONING_EFFORT=

# Fuentes externas opcionales
ALEPH_VIRUSTOTAL_API_KEY=
ALEPH_OTX_API_KEY=
ALEPH_HIBP_API_KEY=
ALEPH_X_BEARER_TOKEN=
ALEPH_GITHUB_TOKEN=
