# Copiar a deploy/.env y completar. Este archivo no se versiona.
ALEPH_DB_PASSWORD=
ALEPH_SECRET_KEY=
ALEPH_ADMIN_USERNAME=admin
ALEPH_ADMIN_PASSWORD=

# 1 = sembrar el caso de demostración ficticio al arrancar (usuarios analista-demo y auditor-demo)
ALEPH_SEED_DEMO=0
ALEPH_DEMO_PASSWORD=

# IA local (cualquier servidor compatible con la API de OpenAI dentro de la red propia).
# Con el perfil "ia" de este compose: http://ollama:11434/v1
ALEPH_LLM_BASE_URL=http://ollama:11434/v1
ALEPH_LLM_MODEL=qwen3:8b
ALEPH_LLM_REASONING_EFFORT=none
ALEPH_EMBED_BASE_URL=http://ollama:11434/v1
ALEPH_EMBED_MODEL=bge-m3

# Puertos publicados
ALEPH_API_PORT=8100
ALEPH_WEB_PORT=8101
ALEPH_WEB_FULL_PORT=8102
